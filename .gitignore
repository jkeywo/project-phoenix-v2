# Generated by Cargo
# will have compiled files and executables
debug
target
dist
# The unanchored `debug` pattern above (Cargo's build-output dir) also matches
# the SOURCE module `src/debug/` — the PRD #1144 debug-observability pipeline —
# so re-include it explicitly. (issue #1145)
!src/debug/
# Model-viewer Trunk output + its generated model index (scripts/generate-model-index.mjs)
dist-viewer
assets/models/index.json
assets/entities/index.json
raw
.planning
.obsidian
.claude
.codegraph
.understand-anything
.sandcastle
.scratch
.worktrees/
.phoenix/

node_modules

# Playwright test artefacts
tests/smoke/test-results
tests/smoke/playwright-report
tests/smoke/.captures

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
/.codegraph/daemon.pid
tests/smoke/test-results-full.json

# balance-runs.mjs --out dir (example config uses .balance-out)
.balance-out/

# Opt-in #1320 event assets, derived from integrated Combat Test before building.
/assets/worlds/prepared/gm_live_event_two_ship.toml
/assets/scenarios.gm-live-event.toml

# Python
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
.venv/
*.egg-info/

# Distribution / packaging
.Python

# wrangler local dev state + local-only worker secrets
worker/.wrangler/
worker/.dev.vars

# Ultralight runtime debris, from a `--features ultralight` build's local
# Station panes (issue #1122). None of it is source and none of it may land:
#   resources/  the SDK's own CA bundle and ICU table, staged into the working
#               directory at startup by vellum_ultralight::staging. Ultralight
#               is proprietary and is never vendored into this repository.
#   default/    Ultralight's own per-origin session storage (cookies,
#               localStorage) for whatever port a pane was served on. Only a
#               pane that asked for no session of its own lands here.
#   pane-<n>/   one per pane, because each pane gets its OWN storage session
#               (`PaneSession`, so two panes served from this host's single
#               origin do not share a cookie jar). Ultralight lays a directory
#               down per session even for a NON-persistent one — the session is
#               still in memory, but the SDK creates the path — so this is
#               per-run junk rather than state anything reads back.
#   ultralight.log  the SDK's own log, written beside the process
/resources/
/default/
/pane-*/
ultralight.log
