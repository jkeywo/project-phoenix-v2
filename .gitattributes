# Normalize line endings: LF in the repository, always. This repo is edited on
# Windows and consumed by CI on Linux; without this, the same file exists as two
# different byte sequences depending on who checked it out, and every cross-repo
# diff (comparing against vellum, or vendoring from it) is noise.
#
# Determinism fixtures make this load-bearing rather than cosmetic: a fingerprint
# taken over content must not depend on which machine checked the content out.
# See vellum's docs/handbook/determinism.md — that bug has been shipped once.
* text=auto

# Text, LF in the working tree as well as in the repository.
*.rs text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.wgsl text eol=lf
*.txt text eol=lf
*.ron text eol=lf

# Windows-only helper scripts keep CRLF; cmd.exe is the consumer.
*.bat text eol=crlf

# Cloudflare Pages configuration, which carries no extension and is parsed line
# by line off the uploaded directory. Pinned rather than left to whatever a
# Windows checkout produces (PRD #855).
_headers text eol=lf
_redirects text eol=lf

# Binary assets — never touched, never diffed as text.
*.png binary
*.webp binary
*.glb binary
*.mp3 binary
*.ttf binary
*.wasm binary

# Committed mod-pack test fixtures (issue #986) — deterministic store-only ZIPs
# generated by scripts/build-mod-pack-fixtures.mjs. Never line-ending-rewritten,
# never diffed as text; regenerate them, never hand-edit.
*.zip binary
